# ==============================================================================
# MARTHAPP - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env y rellena los valores correspondientes:
# cp .env.example .env
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- FIREBASE / FCM PUSH NOTIFICATIONS ---
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MOBILE_SDK_APP_ID=your_firebase_mobile_app_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PACKAGE_NAME=com.example.marth_app

# --- MULTIMEDIA / LEISURE MODULE APIS ---
# The Movie Database (TMDB) API v3
TMDB_API_KEY=your_tmdb_api_key

# Twitch Developer / IGDB API v4
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# RAWG Video Games Database API
RAWG_API_KEY=your_rawg_api_key

# --- INTERNAL INTER-SERVICE SECURITY ---
INTERNAL_PUSH_SECRET=your_internal_push_secret
